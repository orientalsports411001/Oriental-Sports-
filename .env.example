# Oriental Sports Pune — Vite SPA (src/) environment variables.
# Copy this file to .env and fill in real values.

# --- Supabase (PostgreSQL Database + Auth / Google OAuth) -----------------
# Project Settings -> API in your Supabase Dashboard: https://supabase.com/dashboard
# Or local Docker stack (http://127.0.0.1:54321)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- Razorpay Payment Gateway ---------------------------------------------
# Dashboard -> Settings -> API Keys
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
