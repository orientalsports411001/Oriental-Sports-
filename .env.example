# Oriental Sports — legacy Vite SPA (src/) environment variables.
#
# The Shopify Storefront API integration has been removed from this app
# (src/services/shopify.ts, src/types/shopify.ts) — product data and cart
# are local-only here. The actively developed app has moved to
# apps/storefront (Next.js + Supabase + Razorpay); see its own
# apps/storefront/.env.example and docs/MIGRATION.md.

# Razorpay Payment Gateway publishable key id (Dashboard -> Settings -> API Keys)
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
