# Oriental Sports — Headless Shopify Configuration
# Storefront API credentials can be obtained from:
# Shopify Admin -> Settings -> Apps and sales channels -> Develop apps -> Create an app -> Configure Storefront API scopes

# Your myshopify domain (e.g. oriental-sports.myshopify.com)
VITE_SHOPIFY_STORE_DOMAIN=oriental-sports.myshopify.com

# Public Storefront API access token (Safe for client-side frontend use)
VITE_SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_public_storefront_access_token_here

# Shopify Storefront API Version
VITE_SHOPIFY_API_VERSION=2024-10

# Currency / Country ISO code
VITE_SHOPIFY_COUNTRY_CODE=IN

# Razorpay Payment Gateway Key (Key ID from Razorpay Dashboard -> Settings -> API Keys)
VITE_RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
