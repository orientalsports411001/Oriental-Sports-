# Oriental Sports Pune — Next.js storefront environment variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Supabase -----------------------------------------------------------
# Project Settings -> API, in the Supabase dashboard (or printed by
# `supabase start` when running the local stack via Docker).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service-role key — SERVER ONLY. Used by scripts/seed-supabase.mjs and by
# the Razorpay verify/webhook route handlers to write order rows after
# independently verifying payment signatures. Never expose this to the
# browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- Razorpay -------------------------------------------------------------
# Dashboard -> Settings -> API Keys. The key id is also returned to the
# client from /api/razorpay/create-order, so no NEXT_PUBLIC_ variant is needed.
RAZORPAY_KEY_ID=rzp_test_your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here

# Dashboard -> Settings -> Webhooks -> (webhook) -> Secret.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here
