# Oriental Sports Pune — admin app environment variables
# Copy this file to .env.local and fill in real values. Never commit .env.local.

# --- Supabase -----------------------------------------------------------
# Project Settings -> API, in the Supabase dashboard (or printed by
# `supabase start` when running the local stack via Docker). Same project as
# apps/storefront — this app duplicates the client setup, not the project.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Service-role key — SERVER ONLY. Used for all privileged admin reads/writes
# (products, categories, orders, inventory_adjustments). Never expose this to
# the browser or prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- AI SEO generation ----------------------------------------------------
# Server-only — never exposed to the browser. Get a key from
# https://console.anthropic.com/settings/keys. Without it, the "Generate SEO
# with AI" button in the product editor returns a clear configuration error
# instead of crashing.
ANTHROPIC_API_KEY=
# Optional — defaults to claude-haiku-5-5 if unset.
ANTHROPIC_MODEL=claude-haiku-5-5

# Used by the SEO editor's search-result preview to build the public product
# URL. Falls back to the production domain if unset.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cloudinary (product image uploads) -----------------------------------
# From the Cloudinary dashboard (https://console.cloudinary.com/) -> account
# home screen / Settings -> Access Keys. Cloud name is not sensitive (the
# browser needs it to POST directly to Cloudinary) but the API key/secret
# are server-only — never prefix them with NEXT_PUBLIC_.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Resend (Email Notifications) -----------------------------------------
# Server-only. Get an API key from https://resend.com/api-keys
# If left empty, email dispatcher operates in simulated console-logging mode
# without failing or blocking order operations.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Oriental Sports <orders@orientalsports.in>
